# Archify-delivered, self-contained map: needs inline scripts/styles and data:/blob: URLs,
# and must be frameable by the Use Cases page on the same origin.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
