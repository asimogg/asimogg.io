# ---------------------------------------------------------------
# asimogg.io — server hardening
# ---------------------------------------------------------------

Options -Indexes
AddDefaultCharset UTF-8
ServerSignature Off

# Only these files are meant to be public. Everything else that lives in the
# repo (docs, dotfiles, config) is denied even though it is deployed.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|json|lock|log|sh|bak|orig|sql|env|yml|yaml|gs)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Caching: pages always revalidate, versioned assets cache long.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Transport + framing + sniffing
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By

  # Content Security Policy: everything first-party except Google Fonts and Analytics.
  # No inline scripts anywhere; inline <style> is allowed for the standalone decks.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://i.ytimg.com https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://www.googletagmanager.com; frame-src 'self'; media-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# One error page for everything that goes wrong (missing, forbidden, server error)
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html
ErrorDocument 503 /404.html

# Force HTTPS (host already redirects; this covers any bypass)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # One canonical origin: www -> apex (keeps Google Sign-In and Analytics on a single origin)
  RewriteCond %{HTTP_HOST} ^www\.asimogg\.io$ [NC]
  RewriteRule ^ https://asimogg.io%{REQUEST_URI} [R=301,L]

  # The Use Cases page became the Agent Map page (2026-09-09)
  RewriteRule ^usecases/?$ /agentmap/ [R=301,L]
  RewriteRule ^usecases/(.*)$ /agentmap/$1 [R=301,L]

  # Gated originals (decks, film) and server-side includes are never served directly
  RewriteRule ^(private|tools)/ - [F]
  RewriteRule ^(lib|settings)\.php$ - [F]

  # Media in /assets is playable only from pages on this site: direct URL
  # visits and hotlinks from elsewhere get 403.
  RewriteCond %{REQUEST_URI} ^/assets/.*\.(mp4|webm|m4v)$ [NC]
  RewriteCond %{HTTP_REFERER} !^https://(www\.)?asimogg\.io/ [NC]
  RewriteRule ^ - [F]
</IfModule>

# Public media in /assets (site animations): inline, cacheable. The gated film
# lives in /private and is streamed by media.php with its own headers.
<FilesMatch "\.(mp4|webm|m4v)$">
  Header set Content-Disposition "inline"
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>
