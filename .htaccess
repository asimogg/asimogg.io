# Pages: always revalidate so Safari and other browsers never show a stale build.
# CSS/JS/fonts are versioned by query string, so they can cache long.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
