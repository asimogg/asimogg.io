# ---------------------------------------------------------------
# asimogg.io — server hardening
# ---------------------------------------------------------------

Options -Indexes
AddDefaultCharset UTF-8
ServerSignature Off

# Only these files are meant to be public. Everything else that lives in the
# repo (docs, dotfiles, config) is denied even though it is deployed.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|json|lock|log|sh|bak|orig|sql|env|yml|yaml|gs)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Caching: pages always revalidate, versioned assets cache long.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Transport + framing + sniffing
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By

  # Content Security Policy: everything first-party except the deck's Google Fonts.
  # No inline scripts anywhere; inline <style> is allowed for the standalone decks.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://accounts.google.com/gsi/ https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://www.googletagmanager.com; frame-src https://accounts.google.com/gsi/; media-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# Force HTTPS (host already redirects; this covers any bypass)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Gated originals (decks, film) and server-side includes are never served directly
  RewriteRule ^(private|tools)/ - [F]
  RewriteRule ^(lib|settings)\.php$ - [F]

  # Media in /assets is playable only from pages on this site: direct URL
  # visits and hotlinks from elsewhere get 403.
  RewriteCond %{REQUEST_URI} ^/assets/.*\.(mp4|webm|m4v)$ [NC]
  RewriteCond %{HTTP_REFERER} !^https://(www\.)?asimogg\.io/ [NC]
  RewriteRule ^ - [F]
</IfModule>

# Never offer media as an attachment; no caching of the file on disk by proxies
<FilesMatch "\.(mp4|webm|m4v)$">
  Header set Content-Disposition "inline"
  Header set Cache-Control "private, no-store"
</FilesMatch>
